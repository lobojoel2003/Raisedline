{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "paths": {
      "@raisedline/core": ["./packages/core/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/test/**/*",
    "packages/web/vite.config.ts",
    "e2e/**/*",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
