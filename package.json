{
  "name": "raisedline-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Raisedline: charts and maps you can read by touch.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lobojoel2003/Raisedline.git"
  },
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/web"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build -w @raisedline/core && npm run build -w @raisedline/web && npm run build:single -w @raisedline/web && npm run build -w raisedline",
    "build:single": "npm run build:single -w @raisedline/web",
    "dev": "npm run dev -w @raisedline/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --trace off",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "version:check": "node scripts/check-version.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "release:package": "node scripts/package-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  }
}
